<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Vault Files</title>
  <style>
    :root { --bg:#0b1020; --panel:#11182b; --panel2:#17213a; --line:#273451; --text:#edf3ff; --muted:#93a4c2; --accent:#68a4ff; --accent2:#55ddc0; --danger:#ff6d82; --shadow:0 18px 60px rgba(0,0,0,.25); }
    * { box-sizing:border-box; }
    html,body { margin:0; min-height:100%; background:radial-gradient(circle at 10% 0%,#182748 0,#0b1020 42%); color:var(--text); font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    button,input,textarea { font:inherit; }
    button { border:1px solid var(--line); border-radius:9px; padding:9px 13px; cursor:pointer; color:var(--text); background:var(--panel2); transition:.18s ease; }
    button:hover { border-color:#4c6aa3; background:#203054; transform:translateY(-1px); }
    button.primary { background:linear-gradient(135deg,#4d8df7,#7568f7); border-color:transparent; }
    button.danger { color:#ffabb7; }
    input,textarea { border:1px solid var(--line); border-radius:9px; color:var(--text); background:#0b1224; outline:none; padding:10px 12px; }
    input:focus,textarea:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(104,164,255,.14); }
    .hidden { display:none !important; }
    .login-screen { min-height:100vh; display:grid; place-items:center; padding:24px; }
    .login-card { width:min(430px,100%); background:rgba(17,24,43,.92); border:1px solid var(--line); border-radius:22px; padding:34px; box-shadow:var(--shadow); backdrop-filter:blur(14px); }
    .brand { display:flex; align-items:center; gap:11px; font-size:18px; font-weight:800; letter-spacing:.02em; }
    .logo { display:grid; place-items:center; width:36px; height:36px; border-radius:12px; color:#071020; background:linear-gradient(135deg,var(--accent2),var(--accent)); font-weight:900; }
    .login-card h1 { font-size:28px; margin:28px 0 8px; letter-spacing:-.04em; }
    .login-card p { color:var(--muted); margin:0 0 25px; }
    .stack { display:grid; gap:13px; }
    .stack label { color:var(--muted); font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.09em; }
    .stack input { width:100%; margin-top:6px; }
    .login-error { min-height:20px; color:#ff9cab; margin-top:12px; }
    .app { min-height:100vh; display:flex; flex-direction:column; }
    header { height:68px; display:flex; align-items:center; justify-content:space-between; padding:0 24px; background:rgba(11,16,32,.76); border-bottom:1px solid var(--line); backdrop-filter:blur(13px); }
    .header-actions,.toolbar,.crumbs { display:flex; align-items:center; gap:9px; }
    .user-chip { display:flex; align-items:center; gap:8px; color:var(--muted); margin-right:8px; }
    .avatar { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:#2d4674; color:white; font-weight:800; }
    main { width:min(1500px,100%); margin:0 auto; padding:24px; flex:1; display:flex; flex-direction:column; gap:16px; }
    .toolbar { flex-wrap:wrap; }
    .toolbar .grow { flex:1; }
    .search { min-width:220px; width:min(350px,100%); }
    .crumbs { overflow:auto; white-space:nowrap; padding:8px 2px; color:var(--muted); }
    .crumb { color:#cbd8ef; cursor:pointer; }
    .crumb:hover { color:var(--accent); }
    .separator { color:#496081; }
    .dropzone { border:1px dashed #3f5b8c; border-radius:13px; padding:10px 14px; color:var(--muted); background:rgba(18,31,58,.45); text-align:center; }
    .dropzone.drag { border-color:var(--accent2); color:var(--accent2); background:rgba(85,221,192,.08); }
    .file-panel { flex:1; min-height:390px; overflow:hidden; background:rgba(17,24,43,.82); border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); }
    .table-wrap { overflow:auto; height:100%; }
    table { width:100%; border-collapse:collapse; min-width:750px; }
    th { position:sticky; top:0; z-index:1; text-align:left; padding:13px 16px; color:#8194b5; background:#11182b; border-bottom:1px solid var(--line); font-size:11px; text-transform:uppercase; letter-spacing:.09em; }
    td { padding:13px 16px; border-bottom:1px solid rgba(39,52,81,.7); color:#cbd8ef; }
    tr:hover td { background:rgba(41,64,107,.25); }
    tr.selected td { background:rgba(104,164,255,.14); }
    .name-cell { display:flex; align-items:center; gap:11px; min-width:280px; }
    .icon { width:28px; text-align:center; font-size:19px; }
    .file-name { color:var(--text); font-weight:650; cursor:pointer; }
    .file-name:hover { color:var(--accent); }
    .folder-name { color:#9cc5ff; }
    .muted { color:var(--muted); }
    .row-actions { display:flex; gap:7px; justify-content:flex-end; opacity:.65; }
    tr:hover .row-actions { opacity:1; }
    .row-actions button { padding:5px 8px; font-size:12px; }
    .empty { text-align:center; padding:55px 20px; color:var(--muted); }
    .statusbar { display:flex; gap:16px; color:var(--muted); font-size:12px; padding:0 3px; }
    .terminal { height:350px; display:flex; flex-direction:column; background:#060b15; border:1px solid #263b5d; border-radius:16px; overflow:hidden; box-shadow:var(--shadow); }
    .terminal-head { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:#101a2d; border-bottom:1px solid #263b5d; }
    .terminal-title { display:flex; align-items:center; gap:9px; font-weight:750; }
    .terminal-dot { width:9px; height:9px; border-radius:50%; background:var(--accent2); box-shadow:0 0 12px var(--accent2); }
    .terminal-output { flex:1; overflow:auto; padding:13px 15px; white-space:pre-wrap; word-break:break-word; color:#bfe6d8; font:13px/1.5 "SFMono-Regular",Consolas,monospace; }
    .terminal-input { border:0; border-top:1px solid #1b2b49; border-radius:0; width:100%; padding:12px 15px; background:#0a1220; color:#f1f7ff; font:13px "SFMono-Regular",Consolas,monospace; }
    .modal-backdrop { position:fixed; inset:0; z-index:20; display:grid; place-items:center; padding:20px; background:rgba(2,6,17,.72); backdrop-filter:blur(8px); }
    .modal { width:min(850px,100%); max-height:90vh; display:flex; flex-direction:column; background:#121b30; border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); overflow:hidden; }
    .modal.small { width:min(460px,100%); }
    .modal-head { display:flex; justify-content:space-between; align-items:center; padding:17px 20px; border-bottom:1px solid var(--line); }
    .modal-head h2 { margin:0; font-size:17px; }
    .modal-body { padding:20px; overflow:auto; }
    .modal-foot { display:flex; justify-content:flex-end; gap:9px; padding:15px 20px; border-top:1px solid var(--line); }
    #editor { min-height:440px; resize:vertical; width:100%; font:13px/1.55 "SFMono-Regular",Consolas,monospace; }
    .audit-list { display:grid; gap:8px; }
    .audit-item { padding:11px 12px; background:#0d1527; border:1px solid #202f4c; border-radius:9px; font-size:12px; }
    .audit-item code { color:#9cc5ff; }
    .toast { position:fixed; right:22px; bottom:22px; z-index:40; max-width:380px; padding:12px 15px; border:1px solid #3d5f91; border-radius:10px; background:#17284a; color:#e7f0ff; box-shadow:var(--shadow); }
    @media (max-width:700px) { header { padding:0 14px; } header .brand span { display:none; } main { padding:14px; } .user-chip { display:none; } .search { width:100%; min-width:180px; } .toolbar .grow { display:none; } }
  </style>
</head>
<body>
  <section id="loginScreen" class="login-screen">
    <form id="loginForm" class="login-card">
      <div class="brand"><span class="logo">V</span><span>Vault Files</span></div>
      <h1>Sign in to your workspace</h1>
      <p>Manage files, inspect content, and open a secure browser terminal.</p>
      <div class="stack">
        <label>Username<input id="username" autocomplete="username" value="admin" required /></label>
        <label>Password<input id="password" type="password" autocomplete="current-password" required /></label>
        <button class="primary" type="submit">Open file manager</button>
      </div>
      <div id="loginError" class="login-error"></div>
    </form>
  </section>

  <section id="app" class="app hidden">
    <header>
      <div class="brand"><span class="logo">V</span><span>Vault Files</span></div>
      <div class="header-actions">
        <div class="user-chip"><span class="avatar" id="avatar">A</span><span id="userName">admin</span></div>
        <button id="terminalBtn">Terminal</button>
        <button id="logoutBtn">Log out</button>
      </div>
    </header>
    <main>
      <div class="toolbar">
        <button id="upBtn">Up</button><button id="refreshBtn">Refresh</button><button id="newFolderBtn">New folder</button><button id="uploadBtn" class="primary">Upload</button>
        <input id="filePicker" type="file" multiple class="hidden" />
        <span class="grow"></span>
        <input id="search" class="search" placeholder="Search current folder" />
        <button id="hiddenBtn">Show hidden</button><button id="auditBtn">Audit log</button>
      </div>
      <div id="crumbs" class="crumbs"></div>
      <div id="dropzone" class="dropzone">Drop files here to upload into the current folder, or use Upload.</div>
      <section class="file-panel"><div class="table-wrap">
        <table><thead><tr><th>Name</th><th>Type</th><th>Size</th><th>Modified</th><th>Permissions</th><th></th></tr></thead><tbody id="fileRows"></tbody></table>
      </div></section>
      <div class="statusbar"><span id="pathStatus">/</span><span id="countStatus">0 items</span><span id="rootStatus"></span></div>
      <section id="terminal" class="terminal hidden">
        <div class="terminal-head"><div class="terminal-title"><span class="terminal-dot"></span>Browser terminal <span class="muted" id="terminalState">connecting…</span></div><button id="clearTerminal">Clear</button></div>
        <pre id="terminalOutput" class="terminal-output"></pre><textarea id="terminalInput" class="terminal-input" rows="1" placeholder="Type a command and press Enter"></textarea>
      </section>
    </main>
  </section>

  <div id="editorModal" class="modal-backdrop hidden"><div class="modal"><div class="modal-head"><h2 id="editorTitle">Edit file</h2><button data-close="editorModal">Close</button></div><div class="modal-body"><textarea id="editor" spellcheck="false"></textarea></div><div class="modal-foot"><button data-close="editorModal">Cancel</button><button id="saveBtn" class="primary">Save changes</button></div></div></div>
  <div id="promptModal" class="modal-backdrop hidden"><form id="promptForm" class="modal small"><div class="modal-head"><h2 id="promptTitle">New folder</h2><button type="button" data-close="promptModal">Close</button></div><div class="modal-body"><input id="promptInput" style="width:100%" autocomplete="off" /></div><div class="modal-foot"><button type="button" data-close="promptModal">Cancel</button><button class="primary" type="submit">Continue</button></div></form></div>
  <div id="auditModal" class="modal-backdrop hidden"><div class="modal"><div class="modal-head"><h2>Audit log</h2><button data-close="auditModal">Close</button></div><div id="auditBody" class="modal-body audit-list"></div></div></div>
  <div id="toast" class="toast hidden"></div>

  <script>
    const $ = (id) => document.getElementById(id);
    const state = { path: '/', showHidden: false, search: '', items: [], selected: null, editPath: null, ws: null };
    const formatBytes = (n) => { if (!n) return '—'; const units=['B','KB','MB','GB','TB']; let i=0, x=n; while(x>=1024&&i<units.length-1){x/=1024;i++;} return `${x.toFixed(i?1:0)} ${units[i]}`; };
    const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function toast(message, error=false) { $('toast').textContent=message; $('toast').classList.remove('hidden'); $('toast').style.borderColor=error?'#a64b60':'#3d5f91'; setTimeout(()=>$('toast').classList.add('hidden'),3500); }
    async function api(url, options={}) { const response=await fetch(url, options); let body={}; try { body=await response.json(); } catch {} if(response.status===401){showLogin(); throw new Error('Authentication required');} if(!response.ok) throw new Error(body.detail || 'Request failed'); return body; }
    function showLogin(){ $('loginScreen').classList.remove('hidden'); $('app').classList.add('hidden'); }
    function showApp(user){ $('loginScreen').classList.add('hidden'); $('app').classList.remove('hidden'); $('userName').textContent=user||'admin'; $('avatar').textContent=(user||'A')[0].toUpperCase(); }
    function renderCrumbs(){ const parts=state.path.split('/').filter(Boolean); let html='<span class="crumb" data-path="/">Root</span>'; let current=''; for(const part of parts){ current+='/'+part; html+=`<span class="separator">/</span><span class="crumb" data-path="${esc(current)}">${esc(part)}</span>`; } $('crumbs').innerHTML=html; $('crumbs').querySelectorAll('.crumb').forEach(el=>el.onclick=()=>loadFiles(el.dataset.path)); }
    function icon(item){ if(item.type==='directory') return '▰'; const ext=item.name.split('.').pop().toLowerCase(); return ['png','jpg','jpeg','gif','webp','svg'].includes(ext)?'▧':['zip','tar','gz'].includes(ext)?'◇':['js','ts','py','css','html','json','md'].includes(ext)?'⌘':'▱'; }
    function renderRows(){ const rows=$('fileRows'); if(!state.items.length){ rows.innerHTML='<tr><td colspan="6" class="empty">This folder is empty.</td></tr>'; return; } rows.innerHTML=state.items.map(item=>`<tr data-path="${esc(item.path)}"><td><div class="name-cell"><span class="icon">${icon(item)}</span><span class="file-name ${item.type==='directory'?'folder-name':''}">${esc(item.name)}</span></div></td><td>${item.type}</td><td>${item.type==='directory'?'—':formatBytes(item.size)}</td><td>${new Date(item.modified).toLocaleString()}</td><td class="muted">${esc(item.mode)}</td><td><div class="row-actions"><button data-action="open">Open</button>${item.type==='file'?'<button data-action="download">Download</button>':''}<button data-action="rename">Rename</button><button class="danger" data-action="delete">Delete</button></div></td></tr>`).join(''); rows.querySelectorAll('tr[data-path]').forEach(row=>{ const item=state.items.find(x=>x.path===row.dataset.path); row.onclick=()=>{state.selected=item; rows.querySelectorAll('tr').forEach(r=>r.classList.remove('selected')); row.classList.add('selected');}; row.ondblclick=()=>openItem(item); row.querySelector('.file-name').onclick=(e)=>{e.stopPropagation();openItem(item);}; row.querySelectorAll('[data-action]').forEach(btn=>btn.onclick=(e)=>{e.stopPropagation();handleAction(btn.dataset.action,item);}); }); }
    async function loadFiles(path=state.path){ try{ const q=new URLSearchParams({path,show_hidden:state.showHidden,search:state.search}); const data=await api('/api/files?'+q); state.path=data.path; state.items=data.items; renderCrumbs(); renderRows(); $('upBtn').disabled=state.path==='/'; $('pathStatus').textContent=state.path; $('countStatus').textContent=`${state.items.length} item${state.items.length===1?'':'s'}`; }catch(e){toast(e.message,true);} }
    function openItem(item){ if(item.type==='directory') loadFiles(item.path); else openEditor(item.path); }
    async function openEditor(path){ try{ const data=await api('/api/file?path='+encodeURIComponent(path)); if(data.binary){ window.open('/api/download?path='+encodeURIComponent(path),'_blank'); return; } state.editPath=path; $('editorTitle').textContent='Edit '+path.split('/').pop(); $('editor').value=data.content; $('editorModal').classList.remove('hidden'); $('editor').focus(); }catch(e){toast(e.message,true);} }
    async function handleAction(action,item){ try{ if(action==='open'){openItem(item);return;} if(action==='download'){window.open('/api/download?path='+encodeURIComponent(item.path),'_blank');return;} if(action==='rename'){openPrompt('Rename item',item.name,async name=>{await api('/api/rename',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:item.path,name})});toast('Renamed');loadFiles();});return;} if(action==='delete'){if(!confirm(`Delete ${item.name}? This cannot be undone.`))return; await api('/api/file?path='+encodeURIComponent(item.path),{method:'DELETE'});toast('Deleted');loadFiles();} }catch(e){toast(e.message,true);} }
    function openPrompt(title,value,callback){ $('promptTitle').textContent=title; $('promptInput').value=value||''; $('promptModal').classList.remove('hidden'); $('promptInput').focus(); $('promptForm').onsubmit=async e=>{e.preventDefault(); const value=$('promptInput').value.trim(); if(!value)return; $('promptModal').classList.add('hidden'); try{await callback(value);}catch(err){toast(err.message,true);}}; }
    async function uploadFiles(files){ for(const file of files){ const form=new FormData(); form.append('path',state.path); form.append('file',file); try{await api('/api/upload',{method:'POST',body:form}); toast(`Uploaded ${file.name}`);}catch(e){toast(`${file.name}: ${e.message}`,true);} } loadFiles(); }
    function connectTerminal(){ if(state.ws && state.ws.readyState<2)return; const panel=$('terminal'); panel.classList.remove('hidden'); const protocol=location.protocol==='https:'?'wss':'ws'; state.ws=new WebSocket(`${protocol}://${location.host}/ws/terminal`); state.ws.onopen=()=>{$('terminalState').textContent='connected'; sendResize();}; state.ws.onclose=()=>{$('terminalState').textContent='disconnected';}; state.ws.onerror=()=>{$('terminalState').textContent='error';}; state.ws.onmessage=(event)=>{ try{const bytes=Uint8Array.from(atob(event.data),c=>c.charCodeAt(0)); $('terminalOutput').appendChild(document.createTextNode(new TextDecoder().decode(bytes))); $('terminalOutput').scrollTop=$('terminalOutput').scrollHeight;}catch{}}; }
    function sendTerminal(data){if(state.ws?.readyState===1)state.ws.send(JSON.stringify({type:'input',data:btoa(unescape(encodeURIComponent(data)))}));}
    function sendResize(){if(state.ws?.readyState===1)state.ws.send(JSON.stringify({type:'resize',rows:Math.max(10,Math.floor($('terminalOutput').clientHeight/19)),cols:Math.max(40,Math.floor($('terminalOutput').clientWidth/8))}));}
    async function loadAudit(){ try{const data=await api('/api/audit'); $('auditBody').innerHTML=data.events.length?data.events.map(e=>`<div class="audit-item"><strong>${esc(e.action)}</strong> <code>${esc(e.path||'')}</code><br><span class="muted">${new Date(e.time).toLocaleString()} · ${esc(e.user||'system')} · ${esc(e.ip||'')}</span></div>`).join(''):'<div class="empty">No audit events yet.</div>'; $('auditModal').classList.remove('hidden');}catch(e){toast(e.message,true);} }
    $('loginForm').onsubmit=async e=>{e.preventDefault(); $('loginError').textContent=''; try{const data=await api('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:$('username').value,password:$('password').value})}); showApp(data.user); const config=await api('/api/config'); $('rootStatus').textContent=`Root: ${config.root}`; loadFiles('/');}catch(err){$('loginError').textContent=err.message;}};
    $('logoutBtn').onclick=async()=>{await api('/api/logout',{method:'POST'});showLogin();};
    $('refreshBtn').onclick=()=>loadFiles(); $('upBtn').onclick=()=>{if(state.path!=='/')loadFiles(state.path.split('/').slice(0,-1).join('/')||'/');};
    $('newFolderBtn').onclick=()=>openPrompt('New folder','',async name=>{const form=new FormData();form.append('path',state.path);form.append('name',name);await api('/api/folder',{method:'POST',body:form});toast('Folder created');loadFiles();});
    $('uploadBtn').onclick=()=>$('filePicker').click(); $('filePicker').onchange=e=>uploadFiles(e.target.files); $('hiddenBtn').onclick=()=>{state.showHidden=!state.showHidden;$('hiddenBtn').textContent=state.showHidden?'Hide hidden':'Show hidden';loadFiles();}; $('auditBtn').onclick=loadAudit;
    $('search').oninput=e=>{state.search=e.target.value;loadFiles();}; $('terminalBtn').onclick=()=>{const panel=$('terminal');panel.classList.toggle('hidden');if(!panel.classList.contains('hidden'))connectTerminal();}; $('clearTerminal').onclick=()=>$('terminalOutput').textContent='';
    $('terminalInput').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();sendTerminal('\r');e.target.value='';return;} if(e.key==='Backspace'){e.preventDefault();sendTerminal('\x7f');return;} if(e.key==='Tab'){e.preventDefault();sendTerminal('\t');return;} if(e.key==='ArrowUp'){e.preventDefault();sendTerminal('\x1b[A');return;} if(e.key==='ArrowDown'){e.preventDefault();sendTerminal('\x1b[B');return;} if(e.key==='ArrowLeft'){e.preventDefault();sendTerminal('\x1b[D');return;} if(e.key==='ArrowRight'){e.preventDefault();sendTerminal('\x1b[C');return;} if(e.ctrlKey){const c=e.key.toLowerCase();if(c>='a'&&c<='z'){e.preventDefault();sendTerminal(String.fromCharCode(c.charCodeAt(0)-96));}return;} if(e.key.length===1){e.preventDefault();sendTerminal(e.key);}};
    $('terminalInput').onpaste=e=>{e.preventDefault();sendTerminal(e.clipboardData.getData('text'));}; window.onresize=sendResize;
    $('dropzone').ondragover=e=>{e.preventDefault();$('dropzone').classList.add('drag');}; $('dropzone').ondragleave=()=>$('dropzone').classList.remove('drag'); $('dropzone').ondrop=e=>{e.preventDefault();$('dropzone').classList.remove('drag');uploadFiles(e.dataTransfer.files);};
    document.querySelectorAll('[data-close]').forEach(btn=>btn.onclick=()=>$(btn.dataset.close).classList.add('hidden')); document.querySelectorAll('.modal-backdrop').forEach(el=>el.onclick=e=>{if(e.target===el)el.classList.add('hidden');});
    $('saveBtn').onclick=async()=>{try{await api('/api/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:state.editPath,content:$('editor').value})});$('editorModal').classList.add('hidden');toast('File saved');loadFiles();}catch(e){toast(e.message,true);}};
    (async()=>{try{const s=await api('/api/session');if(s.authenticated){showApp(s.user);const c=await api('/api/config');$('rootStatus').textContent=`Root: ${c.root}`;loadFiles('/');}}catch{}})();
  </script>
</body>
</html>
