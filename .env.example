# Copy this file to .env (or set these as real environment variables on
# your host / PaaS dashboard) before deploying. None of these are read
# from .env automatically by the app itself — wire it up with your
# platform's env var settings, or `export $(cat .env | xargs)` locally.

# --- Login credentials (change these!) --------------------------------
FM_USERNAME=admin
FM_PASSWORD=change-this-to-something-strong

# --- Session signing key -------------------------------------------------
# Any long random string. If unset, one is generated at process start,
# which means every restart invalidates existing sessions.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FM_SECRET_KEY=

# --- Storage --------------------------------------------------------------
# The directory the file manager is confined to. Everything under this
# path is browsable/editable; nothing outside it is ever reachable.
FM_ROOT=./data

# --- Terminal --------------------------------------------------------------
# Set to false to disable the web terminal entirely (file browser only).
FM_ENABLE_TERMINAL=true
FM_SHELL=/bin/bash

# --- Cookies ----------------------------------------------------------------
# Keep this true in production (HTTPS). Set to false only for local
# http://localhost development.
FM_COOKIE_SECURE=true

# --- Misc -------------------------------------------------------------------
FM_APP_NAME=File Manager
FM_SESSION_MAX_AGE=43200
FM_MAX_LOGIN_ATTEMPTS=5
FM_LOCKOUT_SECONDS=900
FM_MAX_UPLOAD_SIZE=1073741824
